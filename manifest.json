{
  "manifest_version": 3,
  "name": "PayPivot — Salary & Currency Converter",
  "short_name": "PayPivot",
  "version": "1.0.0",
  "description": "Convert a salary between hourly, daily, weekly, monthly and yearly, and between currencies.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PayPivot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.frankfurter.dev/*"]
}
