{
  "manifest_version": 3,
  "name": "PayPivot — Salary & Currency Converter",
  "short_name": "PayPivot",
  "version": "2.0.0",
  "description": "Convert salaries between pay periods and currencies, add up total compensation, and fill job applications faster.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PayPivot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "optional_host_permissions": ["<all_urls>"]
}
